<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Laravel dev server runs over plain HTTP (php artisan serve).
        Allow cleartext traffic only for local development hosts:
        - 10.0.2.2  -> Android emulator's alias for the host machine's localhost
        - localhost / 127.0.0.1 -> local device/emulator loopback
        For a physical device on the same Wi-Fi, replace BASE_URL in
        RetrofitClient.kt with your computer's LAN IP and add it below.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">172.14.5.160</domain>
        <domain includeSubdomains="false">192.168.1.8</domain>
    </domain-config>
</network-security-config>
